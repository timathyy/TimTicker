<UserControl x:Class="TimTicker.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="42,34,42,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="日历" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="回顾计划、时间记录和每日复盘" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Width="42"
                        Padding="0"
                        Content="‹"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Margin="18,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding MonthText}" />
                <Button Width="42"
                        Padding="0"
                        Content="›"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="7" Margin="0,0,0,16">
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周一" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周二" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周三" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周四" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周五" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周六" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="周日" />
                </UniformGrid>
                <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="17">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="22"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="&#xE787;" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="日历视图即将加入" />
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="完成每日计划与时间记录后，你可以在这里回看每一天。"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
