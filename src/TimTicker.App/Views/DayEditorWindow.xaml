<Window x:Class="TimTicker.App.Views.DayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimTicker.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="日期编辑"
        Width="1004"
        Height="820"
        MinWidth="964"
        MinHeight="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Icon="../Assets/AppIcon.ico"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="48"
                VerticalAlignment="Top"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Image Width="28"
                           Height="28"
                           SnapsToDevicePixels="True"
                           Source="../Assets/AppIcon.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button AutomationProperties.Name="最小化"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource CaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Border Height="1.25"
                                    Margin="1,0"
                                    VerticalAlignment="Bottom"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button AutomationProperties.Name="最大化或还原"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource CaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Border x:Name="MaximizeIcon"
                                    Width="9"
                                    Height="9"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    BorderThickness="1.25" />
                            <Grid x:Name="RestoreIcon" Visibility="Collapsed">
                                <Border Width="8"
                                        Height="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.25" />
                                <Border Width="8"
                                        Height="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SidebarBackgroundBrush}"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.25" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button AutomationProperties.Name="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Border Height="1.25"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>
                            <Border Height="1.25"
                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="-45" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <local:TodayView Grid.Row="1" />
    </Grid>
</Window>
