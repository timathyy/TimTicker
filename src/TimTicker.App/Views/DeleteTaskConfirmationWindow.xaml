<Window x:Class="TimTicker.App.Views.DeleteTaskConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认删除"
        Width="430"
        Height="245"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid Margin="20,0,8,0">
                    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="确认删除" />
                    </Border>
                    <Button Width="38"
                            Height="34"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="关闭删除确认窗口"
                            Click="CancelButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Path Data="M 1 1 L 11 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.5" />
                            <Path Data="M 11 1 L 1 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="18">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                            <Path Data="M 9 4.5 L 9 10.5 M 9 13.5 L 9 13.6"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.8" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="确定要删除这项任务吗？" />
                        <TextBlock x:Name="TaskTitleText"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0" Click="ConfirmButton_Click" Content="确认删除" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
