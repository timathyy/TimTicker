<Window x:Class="TimTicker.App.Views.DeleteTaskFolderConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认删除文件夹"
        Width="450"
        Height="280"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="删除任务文件夹？" />
                <TextBlock x:Name="FolderNameText"
                           Margin="0,10,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="文件夹中的任务会移动到根目录；包含子文件夹时不能删除。此操作无法撤销。"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="10,0,0,0" Click="ConfirmButton_Click" Content="删除文件夹" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
