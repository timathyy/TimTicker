<Window x:Class="TimTicker.App.Views.EndDayReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="结束今天"
        Width="620"
        Height="590"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                    CornerRadius="16,16,0,0">
                <Grid Margin="24,0,8,0">
                    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock x:Name="WindowTitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="结束今天" />
                    </Border>
                    <Button Width="38"
                            Height="34"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="关闭结束今日窗口"
                            Click="CancelButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Path Data="M 1 1 L 11 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.5" />
                            <Path Data="M 11 1 L 1 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="30,24,30,20">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="回顾今天" />
                <TextBlock x:Name="IntroText"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="保存完成度与复盘后，今天的计划和时间轴将变为只读。" />
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="计划摘要" />
                            <TextBlock x:Name="CompletionText" Margin="0,10,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="PlanSummaryText" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Padding="16"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="实际时间轴" />
                            <TextBlock x:Name="TimelineCountText" Margin="0,10,0,0" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="TimelineDurationText" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Margin="0,24,0,0" FontWeight="SemiBold" Text="每日复盘（可选）" />
                <TextBox x:Name="ReviewTextBox"
                         Height="130"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         MaxLength="4000"
                         Style="{StaticResource TextBoxStyle}"
                         TextWrapping="Wrap"
                         ToolTip="记录今天做得好的地方、遇到的问题或明天的调整" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="12"
                           Text="结束后仍可通过“重新打开今天”继续修改并重新计算。" />
            </StackPanel>
            <Border Grid.Row="2" Padding="30,16,30,22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Margin="0,0,10,0" Click="CancelButton_Click" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="ConfirmButton" Click="ConfirmButton_Click" Content="结束今天" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
