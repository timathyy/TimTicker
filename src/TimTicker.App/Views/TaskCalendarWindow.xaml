<Window x:Class="TimTicker.App.Views.TaskCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择日期"
        Width="430"
        Height="520"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CalendarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DayBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <Grid Margin="20,0,8,0">
                    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="选择日期" />
                    </Border>
                    <Button Width="38"
                            Height="34"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="关闭日期选择窗口"
                            Click="CancelButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}">
                        <Grid Width="12" Height="12">
                            <Path Data="M 1 1 L 11 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.5" />
                            <Path Data="M 11 1 L 1 11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="22,20,22,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="−1年" Click="PreviousYearButton_Click" Style="{StaticResource CalendarNavigationButtonStyle}" ToolTip="上一年" />
                    <Button Grid.Column="2" Content="‹" Click="PreviousMonthButton_Click" FontFamily="Segoe UI" FontSize="19" Style="{StaticResource CalendarNavigationButtonStyle}" ToolTip="上个月" />
                    <TextBlock x:Name="DisplayedMonthText" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                    <Button Grid.Column="4" Content="›" Click="NextMonthButton_Click" FontFamily="Segoe UI" FontSize="19" Style="{StaticResource CalendarNavigationButtonStyle}" ToolTip="下个月" />
                    <Button Grid.Column="6" Content="+1年" Click="NextYearButton_Click" Style="{StaticResource CalendarNavigationButtonStyle}" ToolTip="下一年" />
                </Grid>
                <UniformGrid Grid.Row="2" Columns="7" Rows="1">
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="一" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="二" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="三" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="四" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="五" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="六" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="日" />
                </UniformGrid>
                <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="4" Columns="7" Rows="6" />
                <Grid Grid.Row="6">
                    <TextBlock x:Name="SelectedDateText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Click="ConfirmButton_Click" Content="确定" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
