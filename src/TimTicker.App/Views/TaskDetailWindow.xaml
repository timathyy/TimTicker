<Window x:Class="TimTicker.App.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700"
        Height="650"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="DetailCardButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="24,0"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="任务详情" />
                    <Button HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="关闭">
                        <Grid Width="12" Height="12">
                            <Path Data="M 1 1 L 11 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.5" />
                            <Path Data="M 11 1 L 1 11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round" StrokeThickness="1.5" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="28,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,14,0,0">
                        <Border Margin="0,0,8,8" Padding="10,5" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" Text="{Binding StatusText}" />
                        </Border>
                        <Border Margin="0,0,8,8" Padding="10,5" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8">
                            <TextBlock Text="{Binding PriorityText}" />
                        </Border>
                    </WrapPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="创建日期" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding CreatedDateText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="截止日期" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding DueDateText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="完成日期" />
                            <TextBlock Margin="0,5,0,0" Text="{Binding CompletedDateText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,22,0,0" FontWeight="SemiBold" Text="任务说明" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DescriptionText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,26,0,10" FontWeight="SemiBold" Text="关联的时间记录" />
                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="暂无关联记录">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTimelineEntries}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TimelineEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Click="TimelineCard_Click"
                                        Style="{StaticResource DetailCardButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TimeText}" />
                                        </StackPanel>
                                        <Path Grid.Column="1"
                                              Width="7"
                                              Height="12"
                                              Margin="14,0,2,0"
                                              VerticalAlignment="Center"
                                              Data="M 1 1 L 6 6 L 1 11"
                                              Fill="Transparent"
                                              Stroke="{DynamicResource TextSecondaryBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeThickness="1.5" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="28,16,28,22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" Click="EditButton_Click" Content="修改" Style="{StaticResource PrimaryButtonStyle}" />
            </Border>
        </Grid>
    </Border>
</Window>
