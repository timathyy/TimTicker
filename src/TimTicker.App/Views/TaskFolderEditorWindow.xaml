<Window x:Class="TimTicker.App.Views.TaskFolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务文件夹"
        Width="460"
        Height="320"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="28">
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" Text="新建任务文件夹" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,8,0,18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="文件夹用于归类和筛选普通任务。" />
                <TextBox x:Name="NameTextBox"
                         MaxLength="80"
                         Style="{StaticResource TextBoxStyle}"
                         ToolTip="文件夹名称" />
                <TextBlock x:Name="ValidationMessage"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource DangerBrush}" />
                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="SaveButton"
                            Margin="10,0,0,0"
                            Click="SaveButton_Click"
                            Content="创建文件夹"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
