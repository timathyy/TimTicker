<Window x:Class="TimTicker.App.Views.TaskFolderMoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="移动任务文件夹"
        Width="480"
        Height="310"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="28">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="移动任务文件夹" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,8,0,18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="目标位置" />
                <ComboBox x:Name="TargetFolderComboBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="FolderId" />
                <TextBlock x:Name="ValidationMessage"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource DangerBrush}" />
                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Margin="10,0,0,0" Click="MoveButton_Click" Content="移动到这里" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
