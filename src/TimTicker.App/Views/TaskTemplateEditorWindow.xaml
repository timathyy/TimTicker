<Window x:Class="TimTicker.App.Views.TaskTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimTicker.App.Controls"
        xmlns:tasks="clr-namespace:TimTicker.Domain.Tasks;assembly=TimTicker.Domain"
        xmlns:templates="clr-namespace:TimTicker.Domain.Templates;assembly=TimTicker.Domain"
        Title="新建自动任务文件夹"
        Width="600"
        Height="800"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0">
                <TextBlock Margin="24,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="新建自动任务文件夹" />
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,26,34,32">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="文件夹与自动生成规则" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="将在当前目录创建一个文件夹，并为它附加自动生成任务的规则。它仍可像普通文件夹一样浏览和存放任务。"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,6" Text="文件夹名称" />
                    <TextBox x:Name="NameTextBox" MaxLength="80" Style="{StaticResource TextBoxStyle}" />
                    <TextBlock Margin="0,16,0,6" Text="任务标题规则" />
                    <TextBox x:Name="PatternTextBox"
                             MaxLength="200"
                             Style="{StaticResource TextBoxStyle}"
                             TextChanged="PatternTextBox_TextChanged" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="占位符：%y 年、%m 月、%d 日、%n 系列序号" />
                    <Border Margin="0,8,0,0" Padding="12" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Margin="0,16,0,6" Text="任务描述（可选）" />
                    <TextBox x:Name="DescriptionTextBox"
                             Height="72"
                             AcceptsReturn="True"
                             MaxLength="4000"
                             Style="{StaticResource TextBoxStyle}"
                             TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Text="优先级" />
                            <ComboBox x:Name="PriorityComboBox" SelectedIndex="0" SelectedValuePath="Tag">
                                <ComboBoxItem Tag="{x:Static tasks:TaskPriority.None}">无优先级</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static tasks:TaskPriority.Low}">低优先级</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static tasks:TaskPriority.Medium}">中优先级</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static tasks:TaskPriority.High}">高优先级</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" Text="生成方式" />
                            <ComboBox x:Name="ScheduleComboBox"
                                      SelectedIndex="0"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="ScheduleComboBox_SelectionChanged">
                                <ComboBoxItem Tag="{x:Static templates:TaskTemplateSchedule.Manual}">仅手动生成</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static templates:TaskTemplateSchedule.Daily}">按天自动生成</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static templates:TaskTemplateSchedule.Weekly}">按周自动生成</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static templates:TaskTemplateSchedule.Monthly}">按月自动生成</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,6" Text="开始日期" />
                            <controls:TaskDateSelector x:Name="StartDateSelector" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,6" Text="周期倍数" />
                            <TextBox x:Name="IntervalTextBox" Text="1" Style="{StaticResource TextBoxStyle}" ToolTip="例如每 2 周填 2" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AutoEnabledCheckBox"
                              Margin="0,16,0,0"
                              Content="启用自动周期生成"
                              IsChecked="True"
                              Style="{StaticResource CircularCheckBoxStyle}" />
                    <TextBlock x:Name="ValidationMessage"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Click="CancelButton_Click" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Margin="10,0,0,0" Click="SaveButton_Click" Content="创建自动任务文件夹" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
