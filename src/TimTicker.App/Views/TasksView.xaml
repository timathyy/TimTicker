<UserControl x:Class="TimTicker.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:application="clr-namespace:TimTicker.Application.Tasks;assembly=TimTicker.Application"
             xmlns:domain="clr-namespace:TimTicker.Domain.Tasks;assembly=TimTicker.Domain"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="TasksView_Loaded"
             PreviewKeyDown="TasksView_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42,34,42,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="任务" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="收集、整理并完成所有待办事项" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="NewTaskButton_Click" Content="＋ 新建任务" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Ctrl+N" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" AutomationProperties.Name="搜索任务" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" ToolTip="搜索标题或描述（Ctrl+F）" />
                <ComboBox Grid.Column="2" MinHeight="42" SelectedIndex="0" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="{x:Null}">所有状态</ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static domain:TaskStatus.Pending}">待完成</ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static domain:TaskStatus.Completed}">已完成</ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static domain:TaskStatus.Archived}">已归档</ComboBoxItem>
                </ComboBox>
                <ComboBox Grid.Column="4" MinHeight="42" SelectedIndex="0" SelectedValue="{Binding SelectedSortOrder}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="{x:Static application:TaskSortOrder.CreatedAtDescending}">创建时间↓</ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static application:TaskSortOrder.DueDateAscending}">截止日期↑</ComboBoxItem>
                    <ComboBoxItem Tag="{x:Static application:TaskSortOrder.PriorityDescending}">优先级↑</ComboBoxItem>
                </ComboBox>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox ItemsSource="{Binding Tasks}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Priority}" />
                                                    <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding DueDate, StringFormat=截止日期：{0:yyyy-MM-dd}}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="编辑" Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="完成">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Pending}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="重新打开">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Completed}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="归档">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Pending}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Completed}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="恢复">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Archived}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Margin="5,0,0,0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Content="删除" Style="{StaticResource SecondaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{Binding EmptyStateTitle}" />
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding EmptyStateDescription}" TextAlignment="Center" />
                            <Button Margin="0,20,0,0" Click="NewTaskButton_Click" Content="新建任务" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsEditorOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding EditorTitle}" />
                        <TextBlock Margin="0,16,0,5" Text="标题" />
                        <TextBox VerticalContentAlignment="Center" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" />
                        <TextBlock Margin="0,14,0,5" Text="描述" />
                        <TextBox Height="96" AcceptsReturn="True" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <TextBlock Margin="0,14,0,5" Text="截止日期" />
                        <DatePicker SelectedDate="{Binding DueDate}" />
                        <TextBlock Margin="0,14,0,5" Text="优先级" />
                        <ComboBox MinHeight="40" SelectedValue="{Binding Priority}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="{x:Static domain:TaskPriority.None}">无优先级</ComboBoxItem>
                            <ComboBoxItem Tag="{x:Static domain:TaskPriority.Low}">低</ComboBoxItem>
                            <ComboBoxItem Tag="{x:Static domain:TaskPriority.Medium}">中</ComboBoxItem>
                            <ComboBoxItem Tag="{x:Static domain:TaskPriority.High}">高</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" Text="{Binding EditorError}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Command="{Binding CancelEditCommand}" Content="取消" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="8,0,0,0" Command="{Binding SaveCommand}" Content="保存" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Ctrl+Enter" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
