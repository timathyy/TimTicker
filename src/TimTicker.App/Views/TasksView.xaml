<UserControl x:Class="TimTicker.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="42,34,42,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="任务" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="收集、整理并完成所有待办事项" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="＋ 新建任务"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="任务功能将在 v0.2.0 提供" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox AutomationProperties.Name="搜索任务"
                     Style="{StaticResource TextBoxStyle}"
                     ToolTip="搜索任务" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Border Padding="16,10"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="10">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="待完成" />
                </Border>
                <Border Margin="6,0,0,0" Padding="16,10" CornerRadius="10">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="已完成" />
                </Border>
                <Border Margin="6,0,0,0" Padding="16,10" CornerRadius="10">
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="已归档" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <Border Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="17">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="&#xE9D5;" />
                </Border>
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="任务池还是空的" />
                <TextBlock Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="随时记下接下来要做的事，不必依赖记忆。"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
