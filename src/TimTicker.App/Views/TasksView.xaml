<UserControl x:Class="TimTicker.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:application="clr-namespace:TimTicker.Application.Tasks;assembly=TimTicker.Application"
             xmlns:domain="clr-namespace:TimTicker.Domain.Tasks;assembly=TimTicker.Domain"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="TasksView_Loaded"
             PreviewKeyDown="TasksView_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskAccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Opacity="0.55" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TaskScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="42,34,42,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="任务" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="收集、整理并完成所有待办事项" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="NewTaskButton_Click"
                    Content="＋ 新建任务"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="Ctrl+N" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="搜索任务"
                     Style="{StaticResource TextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索标题或描述（Ctrl+F）" />
            <ComboBox Grid.Column="2" SelectedIndex="0" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Tag">
                <ComboBoxItem Tag="{x:Null}">所有状态</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static domain:TaskStatus.Pending}">待完成</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static domain:TaskStatus.Completed}">已完成</ComboBoxItem>
            </ComboBox>
            <ComboBox Grid.Column="4" SelectedIndex="0" SelectedValue="{Binding SelectedSortOrder}" SelectedValuePath="Tag">
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.CreatedAtDescending}">创建时间↓</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.CreatedAtAscending}">创建时间↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.DueDateAscending}">截止日期↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.DueDateDescending}">截止日期↓</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.PriorityDescending}">优先级↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.PriorityAscending}">优先级↓</ComboBoxItem>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="4">
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox ItemsSource="{Binding Tasks}"
                         ItemContainerStyle="{StaticResource TaskListItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TaskScrollBarStyle}" />
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Priority, StringFormat=优先级：{0}}" />
                                            <TextBlock Margin="14,0,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="{Binding CreatedDate, StringFormat=创建日期：{0:yyyy-MM-dd}}" />
                                            <TextBlock Margin="14,0,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="{Binding DueDate, StringFormat=截止日期：{0:yyyy-MM-dd}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="14,0,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Text="{Binding CompletedDate, StringFormat=完成日期：{0:yyyy-MM-dd}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CompletedDate}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Margin="0,0,8,0"
                                                AutomationProperties.Name="查看任务详情"
                                                Click="TaskDetailButton_Click"
                                                Content="&#xE946;"
                                                FontFamily="Segoe Fluent Icons"
                                                Style="{StaticResource TaskIconButtonStyle}"
                                                ToolTip="查看详情" />
                                        <Button Margin="0,0,8,0"
                                                Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="完成任务">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TaskAccentIconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Pending}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="18" Height="18">
                                                    <Path Data="M 3 9 L 7 13 L 15 5"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeThickness="2" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button Margin="0,0,8,0"
                                                Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="重新打开任务">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TaskIconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Completed}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="18" Height="18">
                                                    <Path Data="M 14.5 6 A 6 6 0 1 0 15 11"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeThickness="1.8" />
                                                    <Path Data="M 11.5 3 L 14.8 6 L 15.5 1.8"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button Margin="0,0,8,0"
                                                AutomationProperties.Name="编辑任务"
                                                Click="EditTaskButton_Click"
                                                Style="{StaticResource TaskIconButtonStyle}"
                                                ToolTip="编辑任务">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="18" Height="18">
                                                    <Path Data="M 3 15 L 4 11 L 12 3 L 15 6 L 7 14 Z M 10.5 4.5 L 13.5 7.5"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeThickness="1.7" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <Button AutomationProperties.Name="删除任务"
                                                Click="DeleteTaskButton_Click"
                                                Style="{StaticResource TaskIconButtonStyle}"
                                                ToolTip="删除任务">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="18" Height="18">
                                                    <Path Data="M 4 5 L 14 5 M 7 5 L 7 3 L 11 3 L 11 5 M 5.5 7 L 6.2 15 L 11.8 15 L 12.5 7 M 8 8.5 L 8 13 M 10 8.5 L 10 13"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeThickness="1.6" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{Binding EmptyStateTitle}" />
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding EmptyStateDescription}"
                               TextAlignment="Center" />
                    <Button Margin="0,20,0,0" Click="NewTaskButton_Click" Content="新建任务" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
