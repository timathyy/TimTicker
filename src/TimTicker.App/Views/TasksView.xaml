<UserControl x:Class="TimTicker.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:application="clr-namespace:TimTicker.Application.Tasks;assembly=TimTicker.Application"
             xmlns:domain="clr-namespace:TimTicker.Domain.Tasks;assembly=TimTicker.Domain"
             xmlns:viewModels="clr-namespace:TimTicker.App.ViewModels"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="TasksView_Loaded"
             PreviewKeyDown="TasksView_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="StretchListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="TaskActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="FolderContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="HeaderBorder"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    ContextMenuOpening="FolderHeader_ContextMenuOpening"
                                    CornerRadius="8">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource FolderContextMenuStyle}">
                                        <MenuItem Click="MoveFolderMenuItem_Click" Header="移动" Style="{StaticResource FolderContextMenuItemStyle}" />
                                        <MenuItem Click="RenameFolderMenuItem_Click" Header="重命名" Style="{StaticResource FolderContextMenuItemStyle}" />
                                        <Separator Style="{StaticResource FolderContextMenuSeparatorStyle}" />
                                        <MenuItem Click="DeleteFolderMenuItem_Click" Header="删除" Style="{StaticResource FolderContextMenuItemStyle}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Width="16"
                                                  Height="20"
                                                  VerticalAlignment="Center"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Width="6"
                                                          Height="10"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 1 1 L 5 5 L 1 9"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          StrokeThickness="1.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="18,1,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseDirectlyOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:TaskFolderNode}"
                                  ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource FolderTreeItemStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="22"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           Text="{Binding IconGlyph}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTemplateFolder}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock MaxWidth="128"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <Border Margin="6,0,0,0"
                        Padding="5,1"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTemplateFolder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Text="自动" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid Margin="36,30,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="任务管理器" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="像文件资源管理器一样分层整理任务，自动任务文件夹会按规则生成内容" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Click="NewFolderButton_Click" Content="＋ 文件夹" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="8,0,0,0" Click="NewTemplateButton_Click" Content="＋ 自动任务文件夹" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Margin="8,0,0,0"
                        Click="NewTaskButton_Click"
                        Content="＋ 新建任务"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Ctrl+N" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="搜索任务"
                     Style="{StaticResource TextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索标题或描述（Ctrl+F）" />
            <ComboBox Grid.Column="2" SelectedIndex="0" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Tag">
                <ComboBoxItem Tag="{x:Null}">所有状态</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static domain:TaskStatus.Pending}">待完成</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static domain:TaskStatus.Completed}">已完成</ComboBoxItem>
            </ComboBox>
            <ComboBox Grid.Column="4" SelectedIndex="0" SelectedValue="{Binding SelectedSortOrder}" SelectedValuePath="Tag">
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.CreatedAtDescending}">创建时间↓</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.CreatedAtAscending}">创建时间↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.DueDateAscending}">截止日期↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.DueDateDescending}">截止日期↓</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.PriorityDescending}">优先级↑</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static application:TaskSortOrder.PriorityAscending}">优先级↓</ComboBoxItem>
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="4"
                   Foreground="{DynamicResource SuccessBrush}"
                   Text="{Binding StatusMessage}" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="文件夹" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="AllTasksButton_Click"
                                Content="全部"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="2"
                                Click="RootFolderButton_Click"
                                Content="根目录"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>
                    <TreeView x:Name="FolderTree"
                              Grid.Row="3"
                              ItemsSource="{Binding RootFolders}"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Separator Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe Fluent Icons" Text="&#xE8F1;" />
                            <TextBlock Margin="7,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Text="带自动生成规则的文件夹" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Width="36"
                                Height="34"
                                Padding="0"
                                Click="NavigateUpButton_Click"
                                Content="↑"
                                IsEnabled="{Binding CanNavigateUp}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="返回上一级" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentLocationText}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Click="GenerateSelectedTemplateButton_Click"
                            Content="立即生成一项任务"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding IsTemplateFolderSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
                <Border Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasTasks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding Tasks}"
                             ItemContainerStyle="{StaticResource TaskListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <Border Margin="9,0,0,0" Padding="6,2" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TemplateId}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding TemplateSequenceNumber, StringFormat=系列 #{0}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Priority, StringFormat=优先级：{0}}" />
                                                <TextBlock Margin="14,0,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Text="{Binding CreatedDate, StringFormat=日期：{0:yyyy-MM-dd}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Margin="0,0,6,0"
                                                    AutomationProperties.Name="查看任务详情"
                                                    Click="TaskDetailButton_Click"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="详情">
                                                <Grid Width="18" Height="18">
                                                    <Path Data="M 1 9 C 4 4, 14 4, 17 9 C 14 14, 4 14, 1 9 Z"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeLineJoin="Round"
                                                          StrokeThickness="1.5" />
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="1.5" />
                                                </Grid>
                                            </Button>
                                            <Button Margin="0,0,6,0"
                                                    AutomationProperties.Name="完成任务"
                                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="完成">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TaskPrimaryActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Pending}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="18" Height="18">
                                                        <Path Data="M 2.5 9.5 L 7 14 L 15.5 4"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Margin="0,0,6,0"
                                                    AutomationProperties.Name="重新打开任务"
                                                    Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="重开">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TaskActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Completed}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="18" Height="18">
                                                        <Path Data="M 15 7 A 6 6 0 1 0 15 12 M 15 7 L 11 7 M 15 7 L 15 3"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.7" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Margin="0,0,6,0"
                                                    AutomationProperties.Name="编辑任务"
                                                    Click="EditTaskButton_Click"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="编辑">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="18" Height="18">
                                                        <Path Data="M 3 15 L 4 11 L 12 3 L 15 6 L 7 14 Z M 10.5 4.5 L 13.5 7.5"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.7" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button AutomationProperties.Name="删除任务"
                                                    Click="DeleteTaskButton_Click"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="删除">
                                                <Viewbox Width="17" Height="17">
                                                    <Canvas Width="18" Height="18">
                                                        <Path Data="M 3 5 L 15 5 M 7 2.5 L 11 2.5 M 5 5 L 6 15 L 12 15 L 13 5 M 8 8 L 8 12 M 10 8 L 10 12"
                                                              Fill="Transparent"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.5" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTasks}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="{Binding EmptyStateTitle}" />
                        <TextBlock Margin="0,7,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding EmptyStateDescription}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,20,0,0" Click="NewTaskButton_Click" Content="新建任务" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
