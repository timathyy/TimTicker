<Window x:Class="TimTicker.App.Views.TimelineEntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimTicker.App.Controls"
        Title="时间记录"
        Width="660"
        Height="690"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="Window_PreviewKeyDown"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="24,0"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="WindowTitleText"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="补录时间记录" />
            </Border>

            <Grid Grid.Row="1">
                <StackPanel Margin="28,22,28,18">
                    <TextBlock FontWeight="SemiBold" Text="标题" />
                    <TextBox x:Name="TitleTextBox"
                             Margin="0,8,0,18"
                             MaxLength="200"
                             Style="{StaticResource TextBoxStyle}" />

                    <TextBlock FontWeight="SemiBold" Text="说明（可选）" />
                    <TextBox x:Name="DescriptionTextBox"
                             Height="74"
                             Margin="0,8,0,18"
                             AcceptsReturn="True"
                             MaxLength="4000"
                             Style="{StaticResource TextBoxStyle}"
                             TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="分类（可选）" />
                            <TextBox x:Name="CategoryTextBox"
                                     Margin="0,8,0,0"
                                     MaxLength="100"
                                     Style="{StaticResource TextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="关联任务（可选）" />
                            <ComboBox x:Name="TaskComboBox"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="Title"
                                      ItemsSource="{Binding TaskChoices}"
                                      SelectedValuePath="Id" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="TimeFieldsPanel">
                        <TextBlock FontWeight="SemiBold" Text="开始时间" />
                        <Grid Margin="0,8,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <controls:TaskDateSelector x:Name="StartDateSelector" />
                            <TextBox x:Name="StartTimeTextBox"
                                     Grid.Column="2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="24 小时制，例如 09:30" />
                        </Grid>

                        <TextBlock FontWeight="SemiBold" Text="结束时间" />
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <controls:TaskDateSelector x:Name="EndDateSelector" />
                            <TextBox x:Name="EndTimeTextBox"
                                     Grid.Column="2"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="结束日期可选择次日，以记录跨午夜活动" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="ValidationMessage"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="28,16,28,22"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Content="取消"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="SaveButton"
                            Click="SaveButton_Click"
                            Content="添加记录"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
