<UserControl x:Class="TimTicker.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:TimTicker.Domain.Tasks;assembly=TimTicker.Domain"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="TodayView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PlanIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskAccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="TaskScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Margin="1,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Opacity="0.55" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TaskScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="42,34,42,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="今天" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding DateText}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Margin="0,0,10,0" Padding="10,6" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Visibility="{Binding IsDayClosed, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Text="今日已结束" />
                    </Border>
                    <Button Click="EndDayButton_Click"
                            Content="结束今天"
                            IsEnabled="{Binding CanEndDay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDayClosed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Click="ReopenDayButton_Click" Content="重新打开今天">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDayClosed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="今日计划" />
                                <TextBlock Margin="10,2,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="{Binding PlanItemCountText}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Click="NewTaskAndAddButton_Click"
                                        Content="新建并加入"
                                        IsEnabled="{Binding IsDayOpen}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Click="SelectFromTaskPoolButton_Click"
                                        Content="从任务池选择"
                                        IsEnabled="{Binding IsDayOpen}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="330">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPlanItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="16">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="&#xE8FD;" />
                            </Border>
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="今天还没有计划" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="从任务池多选今天要完成的事情，或在上方新建任务并直接加入。"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding PlanItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasPlanItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource TaskScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding PriorityText}" />
                                                    <TextBlock Margin="12,0,0,0" Text="{Binding DueDateText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="12,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Click="PlanTaskDetailButton_Click"
                                                        Style="{StaticResource TaskIconButtonStyle}"
                                                        ToolTip="查看详情">
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 9 1.5 A 7.5 7.5 0 1 1 8.99 1.5 M 9 8 L 9 13 M 9 5 L 9 5.1"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Margin="0,0,8,0"
                                                        Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanComplete}"
                                                        ToolTip="完成任务">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TaskAccentIconButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Pending}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 3 9 L 7 13 L 15 5"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeThickness="2" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ReopenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanReopen}"
                                                        ToolTip="重新打开任务">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TaskIconButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:TaskStatus.Completed}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 14.5 6 A 6 6 0 1 0 15 11"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeThickness="1.8" />
                                                            <Path Data="M 11.5 3 L 14.8 6 L 15.5 1.8"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.8" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="上移" />
                                                <Button Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="下移" />
                                                <Button Command="{Binding DataContext.RemoveFromPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanRemove}"
                                                        Style="{StaticResource TaskIconButtonStyle}"
                                                        ToolTip="移出计划（任务仍保留在任务池）">
                                                    <Viewbox Width="18" Height="18">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 9 6 L 9 3 L 3 3 L 3 15 L 9 15 L 9 12 M 7 9 L 16 9 M 13 6 L 16 9 L 13 12"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="12"
                                   Text="“移出计划”不会完成或删除任务；完成与删除操作仍在任务页进行。" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="完成度" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding CompletionStateText}" />
                        </Grid>
                        <Grid Width="116" Height="116" Margin="0,22,0,14" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource SurfaceSecondaryBrush}" StrokeThickness="10" />
                            <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="7" Opacity="0.85" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding CompletionPercentageText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlanItems}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="未制定计划">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlanItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding CompletionCountText}" />
                        <Border Margin="0,16,0,0" Padding="12,9" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8">
                            <TextBlock MaxHeight="52" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ReviewSummaryText}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </Border>
                        <Button Margin="0,12,0,0" Click="ViewDaySummaryButton_Click" Content="查看今日总结" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsDayClosed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="今日时间轴" />
                            <TextBlock Margin="12,2,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding TotalRecordedTimeText}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Click="StartTimelineEntryButton_Click"
                                    Content="开始记录"
                                    IsEnabled="{Binding CanEndDay}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Click="AddTimelineEntryButton_Click"
                                    Content="手动录入"
                                    IsEnabled="{Binding IsDayOpen}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="12,8"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRunningTimeline}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding RunningTimelineTitle}" />
                                <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="正在记录" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding StopTimelineCommand}"
                                    Content="停止记录"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTimelineItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="还没有时间记录" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="开始记录当前活动，或手工补录已经完成的事情。" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding TimelineItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasTimelineItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource TaskScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding TimeRangeText}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           FontSize="12"
                                                           Text="{Binding DurationText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <Border Margin="8,0,0,0"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="8"
                                                            Visibility="{Binding IsTimerEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Text="计时" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           FontSize="12"
                                                           Text="{Binding CategoryText}" />
                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding LinkedTasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6"
                                                                    Padding="10,7"
                                                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonUp="LinkedTaskCard_MouseLeftButtonUp">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding DueDateText}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal">
                                                                        <Button Margin="0,0,6,0"
                                                                                Command="{Binding DataContext.CompleteLinkedTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding CanComplete}"
                                                                                Style="{StaticResource PlanIconButtonStyle}"
                                                                                ToolTip="完成任务">
                                                                            <Viewbox Width="16" Height="16">
                                                                                <Canvas Width="18" Height="18">
                                                                                    <Path Data="M 3 9 L 7 13 L 15 5"
                                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                          StrokeEndLineCap="Round"
                                                                                          StrokeLineJoin="Round"
                                                                                          StrokeThickness="2" />
                                                                                </Canvas>
                                                                            </Viewbox>
                                                                        </Button>
                                                                        <Button Command="{Binding DataContext.RemoveLinkedTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding CanRemove}"
                                                                                Style="{StaticResource PlanIconButtonStyle}"
                                                                                ToolTip="移出此记录">
                                                                            <Viewbox Width="16" Height="16">
                                                                                <Canvas Width="18" Height="18">
                                                                                    <Path Data="M 4 4 L 14 14 M 14 4 L 4 14"
                                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                          StrokeEndLineCap="Round"
                                                                                          StrokeThickness="1.8" />
                                                                                </Canvas>
                                                                            </Viewbox>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Margin="0,0,6,0"
                                                        Click="TimelineEntryDetailButton_Click"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="查看详情">
                                                    <Viewbox Width="17" Height="17">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 9 1.5 A 7.5 7.5 0 1 1 8.99 1.5 M 9 8 L 9 13 M 9 5 L 9 5.1"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Margin="0,0,6,0"
                                                        Click="EditTimelineEntryButton_Click"
                                                        IsEnabled="{Binding CanEdit}"
                                                        ToolTip="修改记录">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PlanIconButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Viewbox Width="17" Height="17">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 3 15 L 4 11 L 12 3 L 15 6 L 7 14 Z M 10.5 4.5 L 13.5 7.5"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Click="DeleteTimelineEntryButton_Click"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="删除记录">
                                                    <Viewbox Width="17" Height="17">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Data="M 4 5 L 14 5 M 7 5 L 7 3 L 11 3 L 11 5 M 5.5 7 L 6.2 15 L 11.8 15 L 12.5 7 M 8 8.5 L 8 13 M 10 8.5 L 10 13"
                                                                  Fill="Transparent"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.6" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Margin="0,0,0,2"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource DangerBrush}"
                               IsHitTestVisible="False"
                               Text="{Binding TimelineErrorMessage}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
