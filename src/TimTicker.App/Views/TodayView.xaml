<UserControl x:Class="TimTicker.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Loaded="TodayView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PlanIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42,34,42,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="今天" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding DateText}" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="结束今天"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="每日复盘将在 v0.5.0 提供" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox VerticalContentAlignment="Center"
                             AutomationProperties.Name="新建并加入今日计划"
                             Text="{Binding QuickTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}"
                             ToolTip="输入任务标题" />
                    <Button Grid.Column="2"
                            MinWidth="128"
                            Command="{Binding QuickAddTaskCommand}"
                            Content="新建并加入"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="新建任务并直接加入今日计划" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                </Grid.ColumnDefinitions>

                <Border MinHeight="300" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="今日计划" />
                                <TextBlock Margin="10,2,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="{Binding PlanItemCountText}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Click="SelectFromTaskPoolButton_Click"
                                    Content="从任务池选择"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="330">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPlanItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="16">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="&#xE8FD;" />
                            </Border>
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="今天还没有计划" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="从任务池多选今天要完成的事情，或在上方新建任务并直接加入。"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding PlanItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasPlanItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                    <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding PriorityText}" />
                                                    <TextBlock Margin="12,0,0,0" Text="{Binding DueDateText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="12,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↑"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="上移" />
                                                <Button Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="↓"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Style="{StaticResource PlanIconButtonStyle}"
                                                        ToolTip="下移" />
                                                <Button Command="{Binding DataContext.RemoveFromPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="移出计划"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="仅移出今日计划，任务仍保留在任务池" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="12"
                                   Text="“移出计划”不会完成或删除任务；完成与删除操作仍在任务页进行。" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" MinHeight="300" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="完成度" />
                        <Grid Width="116" Height="116" Margin="0,28,0,20" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource SurfaceSecondaryBrush}" StrokeThickness="10" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="v0.5.0" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="完成度与每日复盘将在后续版本提供" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" MinHeight="170" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="今日时间轴" />
                        <Button HorizontalAlignment="Right"
                                Content="开始记录"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="时间记录将在 v0.4.0 提供" />
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="还没有时间记录" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="记录实际做过的事情，让一天留下清晰轨迹。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
