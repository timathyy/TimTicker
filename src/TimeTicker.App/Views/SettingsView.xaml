<UserControl x:Class="TimeTicker.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42,34,42,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="调整 TimeTicker 的外观与本地设置" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="外观" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="选择适合当前环境的显示模式。主题切换会立即生效。" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding UseLightThemeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" Background="#FFFFFFFF" BorderBrush="#FFE5E5E5" BorderThickness="1" CornerRadius="8">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF171717" Text="☀" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="浅色" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding UseDarkThemeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" Background="#FF212121" BorderBrush="#FF3D3D3D" BorderThickness="1" CornerRadius="8">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFF2F2F2" Text="☾" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="深色" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="4" Background="{DynamicResource BorderBrush}" />

                    <Grid Grid.Row="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="强调色" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="用于主要按钮、选中状态与键盘焦点。" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse Width="22" Height="22" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Text="紫色" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="关于" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="TimeTicker v0.1.0 · 本地优先的日历与时间记录工具" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="10,6"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="8">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="开发预览" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
