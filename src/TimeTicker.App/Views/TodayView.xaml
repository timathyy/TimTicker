<UserControl x:Class="TimeTicker.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="42,34,42,42">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="今天" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding DateText}" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="结束今天"
                        IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="每日复盘将在 v0.5.0 提供" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox VerticalContentAlignment="Center"
                             AutomationProperties.Name="快速添加任务"
                             Style="{StaticResource TextBoxStyle}"
                             ToolTip="输入任务标题" />
                    <Button Grid.Column="2"
                            MinWidth="104"
                            Content="添加任务"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="任务功能将在 v0.2.0 提供" />
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                </Grid.ColumnDefinitions>

                <Border MinHeight="260" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="今日计划" />
                            <TextBlock HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="0 项" />
                        </Grid>
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="320">
                            <Border Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="16">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="20"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="&#xE8FD;" />
                            </Border>
                            <TextBlock Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="今天还没有计划" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="从任务池选择今天要完成的事情，保持一天清晰而专注。"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" MinHeight="260" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="完成度" />
                        <Grid Width="116" Height="116" Margin="0,28,0,20" HorizontalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource SurfaceSecondaryBrush}" StrokeThickness="10" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="未制定计划" />
                        </Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="计划后会在这里显示进度" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" MinHeight="170" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="今日时间轴" />
                        <Button HorizontalAlignment="Right"
                                Content="开始记录"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="时间记录将在 v0.4.0 提供" />
                    </Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="还没有时间记录" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="记录实际做过的事情，让一天留下清晰轨迹。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
